{
  "name": "prompt-decompiler",
  "version": "0.1.0",
  "description": "Turn a classifier prompt into a decision table you can inspect and test.",
  "type": "module",
  "bin": {
    "prompt-decompiler": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "llm",
    "prompt-engineering",
    "classification",
    "decision-table",
    "testing",
    "cli"
  ],
  "author": "Jatin Garg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatingargiitk/prompt-decompiler.git"
  },
  "homepage": "https://github.com/jatingargiitk/prompt-decompiler#readme",
  "bugs": {
    "url": "https://github.com/jatingargiitk/prompt-decompiler/issues"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
